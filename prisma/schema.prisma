// =============================================================================
// Esquema de datos — SaaS de reservas deportivas (Fase 1)
//
// Convenciones:
//  - Modelos en PascalCase, columnas en snake_case vía @map, tablas en plural.
//  - Toda entidad de negocio lleva tenantId (complejo). Las relaciones hacia
//    canchas y clientes usan claves compuestas (tenantId, id) para que la BD
//    impida mezclar datos de distintos complejos.
//  - Partes que Prisma no puede expresar (restricciones de exclusión, columnas
//    generadas, triggers, CHECKs y Row Level Security) viven en SQL dentro de
//    las migraciones. Ver prisma/migrations/*/migration.sql y docs/ARQUITECTURA.md.
//  - Montos de dinero en centavos (Int) para evitar errores de punto flotante.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum PlatformRole {
  USER
  SUPERADMIN
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
}

enum SportType {
  FOOTBALL_5
  FOOTBALL_7
  FOOTBALL_11
  PADEL
}

enum ScheduleExceptionKind {
  CLOSED // feriado o cierre extraordinario: no hay turnos ese día operativo
  SPECIAL_HOURS // día especial: reemplaza el horario semanal de ese día
}

enum BookingStatus {
  PENDING // solicitud online esperando aprobación (ocupa el turno)
  CONFIRMED // confirmada (ocupa el turno)
  CANCELLED // cancelada (libera el turno)
  REJECTED // rechazada por el complejo (libera el turno)
  COMPLETED // jugada (sigue ocupando: es historia)
  NO_SHOW // no se presentó (sigue ocupando: es historia)
  EXPIRED // solicitud PENDING que venció sin aprobarse (libera el turno)
}

enum BookingSource {
  ONLINE
  MANUAL
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum NotificationStatus {
  PENDING // en cola (o esperando reintento)
  SENDING // tomada por un worker
  SENT
  FAILED // agotó reintentos o error permanente
  SKIPPED // ya no corresponde (p. ej. la reserva cambió o el complejo desactivó avisos)
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  MERCADOPAGO_MANUAL
  OTHER
}

enum PaymentKind {
  DEPOSIT
  PAYMENT
  REFUND
}

enum SeriesStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum TenantAssetKind {
  LOGO
  COVER
  GALLERY
}

enum ImageStorage {
  DATABASE
  OBJECT
}

enum ActorType {
  USER
  PLATFORM_ADMIN
  PUBLIC
  SYSTEM
}

// -----------------------------------------------------------------------------
// Autenticación (tablas que usa Better Auth). Globales: no pertenecen a un tenant.
// -----------------------------------------------------------------------------

model User {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  email            String       @unique
  emailVerified    Boolean      @default(false) @map("email_verified")
  image            String?
  platformRole     PlatformRole @default(USER) @map("platform_role")
  isDisabled       Boolean      @default(false) @map("is_disabled")
  /// Suspensión administrativa (motivo y fecha) y anonimización (baja con datos personales borrados).
  suspendedAt      DateTime?    @map("suspended_at") @db.Timestamptz(3)
  suspendedReason  String?      @map("suspended_reason")
  anonymizedAt     DateTime?    @map("anonymized_at") @db.Timestamptz(3)
  /// Better Auth (plugin twoFactor). Obligatorio para superadministradores.
  twoFactorEnabled Boolean?     @default(false) @map("two_factor_enabled")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]
  twoFactors  TwoFactor[]
  playerProfile   PlayerProfile?
  favorites       PlayerFavorite[]
  playerBookings  Booking[]        @relation("PlayerBookings")
  reviews         Review[]

  @@map("users")
}

/// Secreto TOTP y códigos de respaldo (cifrados por Better Auth).
model TwoFactor {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id") @db.Uuid
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("two_factors")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

/// Contador de rate limiting compartido entre instancias (ventana fija).
model RateLimit {
  key         String   @id
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int

  @@map("rate_limits")
}

// -----------------------------------------------------------------------------
// Plataforma
// -----------------------------------------------------------------------------

model Tenant {
  id                        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                      String       @unique
  name                      String
  description               String?
  logoUrl                   String?      @map("logo_url")
  timezone                  String       @default("America/Argentina/Buenos_Aires")
  currency                  String       @default("ARS") @db.Char(3)
  status                    TenantStatus @default(ACTIVE)
  suspendedReason           String?      @map("suspended_reason")
  /// Archivado (baja lógica): oculto en todos lados, datos conservados.
  archivedAt                DateTime?    @map("archived_at") @db.Timestamptz(3)
  bookingRequiresApproval   Boolean      @default(true) @map("booking_requires_approval")
  minLeadMinutes            Int          @default(60) @map("min_lead_minutes")
  maxAdvanceDays            Int          @default(30) @map("max_advance_days")
  /// Minutos que una solicitud PENDING retiene el turno antes de vencer.
  pendingExpirationMinutes  Int          @default(30) @map("pending_expiration_minutes")
  /// Hasta cuántos minutos antes del inicio el jugador puede cancelar con su enlace.
  publicCancellationMinutes Int          @default(120) @map("public_cancellation_minutes")
  /// Interruptor general de emails del complejo.
  notificationsEnabled      Boolean      @default(true) @map("notifications_enabled")
  notifyPlayers             Boolean      @default(true) @map("notify_players")
  notifyOwner               Boolean      @default(true) @map("notify_owner")
  /// Destino de los avisos al complejo (si es null se usa contactEmail).
  ownerNotificationEmail    String?      @map("owner_notification_email")
  /// Horas antes del turno para el recordatorio (0 = sin recordatorio).
  reminderHoursBefore       Int          @default(3) @map("reminder_hours_before")
  digestEnabled             Boolean      @default(false) @map("digest_enabled")
  /// Hora local (0-23) del resumen diario de próximas reservas.
  digestHour                Int          @default(8) @map("digest_hour")
  contactPhone              String?      @map("contact_phone")
  contactEmail              String?      @map("contact_email")
  address                   String?
  /// Personalización de la página pública.
  brandColor                String?      @map("brand_color")
  whatsapp                  String?
  instagram                 String?
  facebook                  String?
  website                   String?
  services                  String[]     @default([])
  cancellationPolicy        String?      @map("cancellation_policy")
  /// Aparece en el listado público de complejos de la portada (opt-out).
  publicListed              Boolean      @default(true) @map("public_listed")
  city                      String?
  province                  String?
  /// Ubicación (WGS84) elegida por el complejo en el mapa. Ambas o ninguna.
  latitude                  Float?
  longitude                 Float?
  /// Condiciones de seña (informativas: TURNUP no cobra online todavía).
  depositType               String       @default("NONE") @map("deposit_type")
  depositValue              Int          @default(0) @map("deposit_value")
  depositNote               String?      @map("deposit_note")
  /// Novedad o promoción publicada por el complejo (texto real, con vencimiento).
  announcement              String?
  announcementUntil         DateTime?    @map("announcement_until") @db.Date
  /// Asistente de configuración: último paso completado (0-7) y fin.
  onboardingStep            Int          @default(0) @map("onboarding_step")
  onboardingCompletedAt     DateTime?    @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt                 DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships          Membership[]
  courts               Court[]
  scheduleRules        CourtScheduleRule[]
  priceRules           CourtPriceRule[]
  customers            Customer[]
  bookings             Booking[]
  blocks               AvailabilityBlock[]
  allocations          CourtAllocation[]
  subscriptions        Subscription[]
  exceptions           ScheduleException[]
  courtImages          CourtImage[]
  invitations          Invitation[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  payments             BookingPayment[]
  series               BookingSeries[]
  assets               TenantAsset[]
  subscriptionPayments SubscriptionPayment[]
  favorites            PlayerFavorite[]
  paymentSettings      TenantPaymentSettings?
  paymentIncidents     PaymentIncident[]
  inbox                InboxNotification[]
  reviews              Review[]
  reviewReports        ReviewReport[]
  dailyViews           TenantDailyView[]

  @@map("tenants")
}

model Membership {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  /// Acceso desactivado sin borrar historial (auditoría, reservas creadas por la persona).
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model Plan {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  priceAmount Int      @map("price_amount")
  currency    String   @default("ARS") @db.Char(3)
  maxCourts   Int?     @map("max_courts")
  /// Máximo de miembros del equipo (sin contar dueños). Null = sin límite.
  maxMembers  Int?     @map("max_members")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz(3)
  notes              String?
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan                  @relation(fields: [planId], references: [id])
  payments SubscriptionPayment[]

  @@index([tenantId])
  @@map("subscriptions")
}

// -----------------------------------------------------------------------------
// Complejo: canchas, horarios y precios
// -----------------------------------------------------------------------------

model Court {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  name             String
  sport            SportType
  description      String?
  isActive         Boolean   @default(true) @map("is_active")
  /// Cada cuántos minutos puede empezar un turno (30 = 18:00, 18:30, ...).
  slotStepMinutes  Int       @default(30) @map("slot_step_minutes")
  /// Duraciones permitidas en minutos (p. ej. {60,90,120}).
  allowedDurations Int[]     @default([60, 90, 120]) @map("allowed_durations")
  sortOrder        Int       @default(0) @map("sort_order")
  /// Jugadores por equipo/cancha (informativo).
  capacity         Int?
  /// Precio base por 60 minutos (centavos). Se usa si ninguna regla coincide.
  basePrice        Int?      @map("base_price")
  /// Características públicas (ficha del marketplace).
  surface          String?
  dimensions       String?
  covered          Boolean?
  lighting         Boolean?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  images        CourtImage[]
  exceptions    ScheduleException[]
  scheduleRules CourtScheduleRule[]
  priceRules    CourtPriceRule[]
  bookings      Booking[]
  series        BookingSeries[]
  blocks        AvailabilityBlock[]
  allocations   CourtAllocation[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("courts")
}

/// Franja de apertura de una cancha para un día de la semana (1=lunes ... 7=domingo),
/// expresada en minutos desde la medianoche local. closeMinute puede superar 1440
/// para franjas que cruzan la medianoche (p. ej. 18:00 a 02:00 = 1080..1560).
model CourtScheduleRule {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  courtId     String @map("court_id") @db.Uuid
  weekday     Int    @db.SmallInt
  openMinute  Int    @map("open_minute")
  closeMinute Int    @map("close_minute")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  court  Court  @relation(fields: [tenantId, courtId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, courtId])
  @@map("court_schedule_rules")
}

/// Precio por duración. weekday y la franja horaria son opcionales: la regla más
/// específica que coincida gana (weekday + franja > franja > weekday > general).
model CourtPriceRule {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  courtId         String    @map("court_id") @db.Uuid
  durationMinutes Int       @map("duration_minutes")
  weekday         Int?      @db.SmallInt
  startMinute     Int?      @map("start_minute")
  endMinute       Int?      @map("end_minute")
  /// Tarifa para una fecha puntual (día operativo). Tiene prioridad máxima.
  specialDate     DateTime? @map("special_date") @db.Date
  amount          Int

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  court  Court  @relation(fields: [tenantId, courtId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, courtId])
  @@map("court_price_rules")
}

// -----------------------------------------------------------------------------
// Clientes y reservas
// -----------------------------------------------------------------------------

model Customer {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  /// Clave de deduplicación: email normalizado o "tel:<dígitos>".
  contactKey String   @map("contact_key")
  name       String
  phone      String?
  email      String?
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]
  series   BookingSeries[]

  @@unique([tenantId, id])
  @@unique([tenantId, contactKey])
  @@map("customers")
}

model Booking {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  courtId            String        @map("court_id") @db.Uuid
  customerId         String        @map("customer_id") @db.Uuid
  /// Código legible para el cliente (único por complejo).
  code               String
  status             BookingStatus
  source             BookingSource
  startsAt           DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime      @map("ends_at") @db.Timestamptz(3)
  durationMinutes    Int           @map("duration_minutes")
  /// Precio congelado al momento de reservar (centavos). Null = a confirmar.
  priceAmount        Int?          @map("price_amount")
  currency           String        @db.Char(3)
  customerName       String        @map("customer_name")
  customerPhone      String?       @map("customer_phone")
  customerEmail      String?       @map("customer_email")
  notes              String?
  idempotencyKey     String?       @map("idempotency_key")
  requestFingerprint String?       @map("request_fingerprint")
  createdByUserId    String?       @map("created_by_user_id") @db.Uuid
  /// Solo para PENDING: hasta cuándo retiene el turno. CONFIRMED no vence.
  expiresAt          DateTime?     @map("expires_at") @db.Timestamptz(3)
  expiredAt          DateTime?     @map("expired_at") @db.Timestamptz(3)
  /// Observaciones internas del complejo (nunca se muestran al jugador).
  internalNotes      String?       @map("internal_notes")
  confirmedAt        DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelReason       String?       @map("cancel_reason")
  /// Serie recurrente a la que pertenece (null = turno suelto).
  seriesId           String?       @map("series_id") @db.Uuid
  /// Cuenta de jugador dueña de la reserva (null = invitado). Nunca da acceso al panel.
  playerUserId       String?       @map("player_user_id") @db.Uuid
  /// Estado FINANCIERO (separado del estado de la reserva). null = reserva sin cobro previo (manual/antigua).
  paymentStatus      String?       @map("payment_status")
  /// Importe a transferir calculado por el SERVIDOR al crear la reserva (seña o total), en centavos.
  amountDue          Int?          @map("amount_due")
  /// Titular de la cuenta de origen si NO es el jugador (para que el complejo encuentre el movimiento).
  transferPayerName  String?       @map("transfer_payer_name")
  transferReference  String?       @map("transfer_reference")
  transferReportedAt DateTime?     @map("transfer_reported_at") @db.Timestamptz(3)
  paymentVerifiedAt  DateTime?     @map("payment_verified_at") @db.Timestamptz(3)
  paymentVerifiedBy  String?       @map("payment_verified_by") @db.Uuid
  /// Aviso al complejo de que el plazo de revisión está por vencer (una sola vez).
  reviewAlertedAt    DateTime?     @map("review_alerted_at") @db.Timestamptz(3)
  /// De dónde vino la reserva online: MARKETPLACE (catálogo de TURNUP) o DIRECT (enlace del complejo).
  origin             String?
  /// Optimistic locking para cambios de estado/reprogramación.
  version            Int           @default(1)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  court      Court            @relation(fields: [tenantId, courtId], references: [tenantId, id])
  customer   Customer         @relation(fields: [tenantId, customerId], references: [tenantId, id])
  allocation CourtAllocation?
  series     BookingSeries?   @relation(fields: [tenantId, seriesId], references: [tenantId, id])
  payments   BookingPayment[]
  player     User?            @relation("PlayerBookings", fields: [playerUserId], references: [id], onDelete: SetNull)
  incidents  PaymentIncident[]
  review     Review?

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, startsAt])
  @@index([courtId, startsAt])
  @@index([status, expiresAt])
  @@index([tenantId, seriesId])
  @@index([playerUserId, startsAt])
  @@map("bookings")
}

/// Feriados, cierres extraordinarios y días con horario especial. courtId null = todo el complejo.
/// Pago o seña registrado A MANO por el complejo (efectivo, transferencia...). Nunca datos de tarjeta.
model BookingPayment {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  bookingId        String        @map("booking_id") @db.Uuid
  kind             PaymentKind
  method           PaymentMethod
  /// Centavos, siempre positivo. Las devoluciones usan kind = REFUND.
  amount           Int
  note             String?
  paidAt           DateTime      @default(now()) @map("paid_at") @db.Timestamptz(3)
  recordedByUserId String?       @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [tenantId, bookingId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, paidAt])
  @@index([bookingId])
  @@map("booking_payments")
}

/// Reserva fija semanal (mismo día, hora y cancha) entre dos fechas.
model BookingSeries {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  courtId         String       @map("court_id") @db.Uuid
  customerId      String       @map("customer_id") @db.Uuid
  /// 1 = lunes ... 7 = domingo (ISO).
  weekday         Int
  /// Minutos desde la medianoche local.
  startMinute     Int          @map("start_minute")
  durationMinutes Int          @map("duration_minutes")
  startsOn        DateTime     @map("starts_on") @db.Date
  endsOn          DateTime     @map("ends_on") @db.Date
  status          SeriesStatus @default(ACTIVE)
  notes           String?
  createdByUserId String?      @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  court    Court     @relation(fields: [tenantId, courtId], references: [tenantId, id])
  customer Customer  @relation(fields: [tenantId, customerId], references: [tenantId, id])
  bookings Booking[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("booking_series")
}

/// Logo, portada y galería del complejo.
model TenantAsset {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  kind        TenantAssetKind
  storage     ImageStorage    @default(DATABASE)
  data        Bytes?
  objectKey   String?         @map("object_key")
  contentType String          @map("content_type")
  sizeBytes   Int             @map("size_bytes")
  width       Int?
  height      Int?
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind, sortOrder])
  @@map("tenant_assets")
}

/// Cobro de suscripción registrado a mano por el superadmin. Preparado para Mercado Pago (external_*).
model SubscriptionPayment {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  subscriptionId   String?       @map("subscription_id") @db.Uuid
  amount           Int
  currency         String        @default("ARS") @db.Char(3)
  method           PaymentMethod
  paidAt           DateTime      @map("paid_at") @db.Timestamptz(3)
  periodStart      DateTime      @map("period_start") @db.Date
  periodEnd        DateTime      @map("period_end") @db.Date
  note             String?
  externalProvider String?       @map("external_provider")
  externalId       String?       @map("external_id")
  recordedByUserId String?       @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@unique([externalProvider, externalId])
  @@index([tenantId, paidAt])
  @@map("subscription_payments")
}

model ScheduleException {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String                @map("tenant_id") @db.Uuid
  courtId     String?               @map("court_id") @db.Uuid
  /// Día operativo afectado (fecha local del complejo).
  date        DateTime              @db.Date
  kind        ScheduleExceptionKind
  openMinute  Int?                  @map("open_minute")
  closeMinute Int?                  @map("close_minute")
  reason      String
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  court  Court? @relation(fields: [tenantId, courtId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, date])
  @@map("schedule_exceptions")
}

/// Imágenes de canchas guardadas en la base (tamaño acotado, tipo verificado por firma de bytes).
model CourtImage {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  courtId     String       @map("court_id") @db.Uuid
  contentType String       @map("content_type")
  storage     ImageStorage @default(DATABASE)
  /// Bytes en la base (storage = DATABASE). Null si está en almacenamiento de objetos.
  data        Bytes?
  /// Clave en el bucket S3/R2 (storage = OBJECT).
  objectKey   String?      @map("object_key")
  width       Int?
  height      Int?
  sizeBytes   Int          @map("size_bytes")
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  court  Court  @relation(fields: [tenantId, courtId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, courtId])
  @@map("court_images")
}

/// Bloqueo administrativo (mantenimiento, evento, etc.).
model AvailabilityBlock {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  courtId         String   @map("court_id") @db.Uuid
  startsAt        DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime @map("ends_at") @db.Timestamptz(3)
  reason          String
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  court      Court            @relation(fields: [tenantId, courtId], references: [tenantId, id], onDelete: Cascade)
  allocation CourtAllocation?

  @@index([tenantId, startsAt])
  @@map("availability_blocks")
}

/// Ocupación efectiva de una cancha. La mantienen EXCLUSIVAMENTE triggers sobre
/// bookings y availability_blocks. Una restricción EXCLUDE USING gist sobre
/// (court_id, period) garantiza en la base que dos ocupaciones nunca se solapen,
/// sin importar qué código (o cuántas solicitudes concurrentes) intente escribir.
model CourtAllocation {
  id        String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String                    @map("tenant_id") @db.Uuid
  courtId   String                    @map("court_id") @db.Uuid
  bookingId String?                   @unique @map("booking_id") @db.Uuid
  blockId   String?                   @unique @map("block_id") @db.Uuid
  startsAt  DateTime                  @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime                  @map("ends_at") @db.Timestamptz(3)
  /// Columna generada: tstzrange(starts_at, ends_at, '[)').
  period    Unsupported("tstzrange")? @default(dbgenerated("tstzrange(starts_at, ends_at, '[)'::text)"))

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  court   Court              @relation(fields: [tenantId, courtId], references: [tenantId, id], onDelete: Cascade)
  booking Booking?           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  block   AvailabilityBlock? @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt])
  @@map("court_allocations")
}

// -----------------------------------------------------------------------------
// Equipo: invitaciones
// -----------------------------------------------------------------------------

/// Invitación de un empleado. El token se guarda HASHEADO (SHA-256); es de un solo uso.
model Invitation {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  email           String
  role            MembershipRole
  tokenHash       String         @unique @map("token_hash")
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime?      @map("accepted_at") @db.Timestamptz(3)
  revokedAt       DateTime?      @map("revoked_at") @db.Timestamptz(3)
  invitedByUserId String?        @map("invited_by_user_id") @db.Uuid
  acceptedUserId  String?        @map("accepted_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("invitations")
}

// -----------------------------------------------------------------------------
// Notificaciones (patrón outbox) y operación
// -----------------------------------------------------------------------------

/// Cola persistente de emails. Se inserta en la MISMA transacción que el evento
/// (si la reserva no se confirma, el aviso no existe). El contenido se arma al
/// enviar a partir de la base: no se guardan enlaces privados ni HTML con datos.
model Notification {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String?            @map("tenant_id") @db.Uuid
  kind              String
  recipient         String
  /// Evita duplicados: el mismo evento nunca genera dos avisos.
  dedupeKey         String             @unique @map("dedupe_key")
  bookingId         String?            @map("booking_id") @db.Uuid
  /// Datos mínimos del evento (sin tokens ni datos sensibles).
  payload           Json?
  status            NotificationStatus @default(PENDING)
  attempts          Int                @default(0)
  nextAttemptAt     DateTime           @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedAt          DateTime?          @map("locked_at") @db.Timestamptz(3)
  lastError         String?            @map("last_error")
  providerMessageId String?            @map("provider_message_id")
  sentAt            DateTime?          @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

/// Última ejecución de cada tarea programada (monitoreo y detección de fallas).
model JobRun {
  name                String    @id
  lastStartedAt       DateTime? @map("last_started_at") @db.Timestamptz(3)
  lastFinishedAt      DateTime? @map("last_finished_at") @db.Timestamptz(3)
  lastSuccessAt       DateTime? @map("last_success_at") @db.Timestamptz(3)
  lastStatus          String?   @map("last_status")
  lastError           String?   @map("last_error")
  lastResult          Json?     @map("last_result")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")

  @@map("job_runs")
}

// -----------------------------------------------------------------------------
// Auditoría (solo inserción para el rol de la aplicación)
// -----------------------------------------------------------------------------

model AuditLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  actorType   ActorType @map("actor_type")
  actorUserId String?   @map("actor_user_id") @db.Uuid
  action      String
  entityType  String    @map("entity_type")
  entityId    String?   @map("entity_id")
  metadata    Json?
  ip          String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------- Jugadores (Fase 4)

/// Perfil del jugador (rol global, independiente de las membresías de complejos).
model PlayerProfile {
  userId          String    @id @map("user_id") @db.Uuid
  phone           String?
  city            String?
  favoriteSports  String[]  @default([]) @map("favorite_sports")
  /// OBSOLETO (Fase 5): los jugadores ya no tienen foto. Columnas vaciadas por migración; se eliminan
  /// en una migración posterior al despliegue (compatibilidad con la versión publicada).
  avatar          Bytes?
  avatarUpdatedAt DateTime? @map("avatar_updated_at") @db.Timestamptz(3)
  notifyEmail     Boolean   @default(true) @map("notify_email")
  notifyReminders Boolean   @default(true) @map("notify_reminders")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("player_profiles")
}

model PlayerFavorite {
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@index([tenantId])
  @@map("player_favorites")
}

/// Opinión verificada: una por reserva jugada.
model Review {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  bookingId    String    @unique @map("booking_id") @db.Uuid
  playerUserId String?   @map("player_user_id") @db.Uuid
  rating       Int       @db.SmallInt
  comment      String?
  status       String    @default("PUBLISHED")
  reply        String?
  repliedAt    DateTime? @map("replied_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking        @relation(fields: [tenantId, bookingId], references: [tenantId, id], onDelete: Cascade)
  player  User?          @relation(fields: [playerUserId], references: [id], onDelete: SetNull)
  reports ReviewReport[]

  @@unique([tenantId, id])
  @@unique([tenantId, bookingId])
  @@index([tenantId, status, createdAt])
  @@map("reviews")
}

model ReviewReport {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  reviewId       String    @map("review_id") @db.Uuid
  reporterUserId String?   @map("reporter_user_id") @db.Uuid
  reporterKind   String    @map("reporter_kind")
  reason         String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolution     String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [tenantId, reviewId], references: [tenantId, id], onDelete: Cascade)

  @@unique([reviewId, reporterUserId])
  @@index([resolvedAt])
  @@map("review_reports")
}

/// Visitas diarias a la ficha pública (solo un contador; sin IP ni datos personales).
model TenantDailyView {
  tenantId String   @map("tenant_id") @db.Uuid
  day      DateTime @db.Date
  views    Int      @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, day])
  @@map("tenant_daily_views")
}

// ---------------------------------------------------------------- Transferencias directas (Fase 5)

/// Datos de cobro del complejo. El dinero va DIRECTO a su cuenta; TURNUP no lo toca.
model TenantPaymentSettings {
  tenantId              String   @id @map("tenant_id") @db.Uuid
  alias                 String?
  cbuCvu                String?  @map("cbu_cvu")
  holderName            String?  @map("holder_name")
  bankName              String?  @map("bank_name")
  /// Minutos que tiene el jugador para transferir e informar (bloquea el turno).
  transferWindowMinutes Int      @default(30) @map("transfer_window_minutes")
  /// Minutos que tiene el complejo para revisar una transferencia informada.
  reviewWindowMinutes   Int      @default(180) @map("review_window_minutes")
  instructions          String?
  updatedByUserId       String?  @map("updated_by_user_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_payment_settings")
}

/// Incidencia de pago: dinero recibido por una reserva vencida/rechazada, transferencia tardía, devolución.
model PaymentIncident {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  bookingId       String    @map("booking_id") @db.Uuid
  kind            String
  status          String    @default("OPEN")
  amount          Int?
  notes           String?
  resolution      String?
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  resolvedByUserId String?  @map("resolved_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [tenantId, bookingId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@map("payment_incidents")
}

/// Notificación interna (bandeja) para el equipo de un complejo o para un jugador con cuenta.
model InboxNotification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  kind      String
  title     String
  body      String?
  link      String?
  bookingId String?   @map("booking_id") @db.Uuid
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, readAt, createdAt])
  @@index([userId, readAt, createdAt])
  @@map("inbox_notifications")
}
