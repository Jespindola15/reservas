# Copiá a .env.test para correr `npm run test:integration`. Debe apuntar a una base *_test.
NODE_ENV=test
DATABASE_URL=postgresql://reservas_app:CAMBIAR@localhost:5432/reservas_test
MIGRATION_DATABASE_URL=postgresql://reservas_owner:CAMBIAR@localhost:5432/reservas_test
DB_POOL_MAX=20
BETTER_AUTH_SECRET=solo-para-tests-locales-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3100
TRUST_PROXY_HOPS=0
CRON_SECRET=test-cron-secret-0123456789abcdef0123456789
