{
  "name": "turnup",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:new": "prisma migrate dev --create-only",
    "db:seed": "prisma db seed",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "next build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "postinstall": "prisma generate",
    "job:expire": "tsx scripts/expire-pending.ts",
    "images:migrate": "tsx scripts/migrate-images-to-object.ts",
    "icons": "node scripts/generate-icons.mjs",
    "admin:superadmin": "tsx scripts/ops/create-superadmin.ts",
    "demo:seed": "tsx scripts/ops/seed-demo.ts",
    "db:migrate:prod": "bash scripts/ops/migrate-prod.sh",
    "db:verify": "node scripts/ops/verify-db.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.27",
    "luxon": "^3.7.2",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.1",
    "@playwright/test": "^1.65.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "effect": "^3.22.1"
  },
  "engines": {
    "node": ">=22"
  }
}
