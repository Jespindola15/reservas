# Copiá este archivo a .env y completá. NUNCA commitees .env con valores reales.
NODE_ENV=development

# Rol de la APLICACIÓN (sin BYPASSRLS, no dueño de tablas). RLS aplica.
DATABASE_URL=postgresql://reservas_app:CAMBIAR@localhost:5432/reservas_dev
DB_POOL_MAX=10

# Rol DUEÑO: solo para migraciones y seed (CLI de Prisma). La app nunca lo usa.
MIGRATION_DATABASE_URL=postgresql://reservas_owner:CAMBIAR@localhost:5432/reservas_dev
# Base "shadow" para `prisma migrate dev` (solo desarrollo).
SHADOW_DATABASE_URL=postgresql://reservas_owner:CAMBIAR@localhost:5432/reservas_shadow

# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Detrás de un proxy/CDN: cantidad de proxies confiables y cabecera de IP que el proxy SOBRESCRIBE.
TRUST_PROXY_HOPS=0
AUTH_CLIENT_IP_HEADER=

# Solo desarrollo: contraseñas del seed (si faltan, se generan y se muestran una vez).
SEED_SUPERADMIN_PASSWORD=
SEED_OWNER_PASSWORD=
