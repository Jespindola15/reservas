# Copiá este archivo a .env y completá. NUNCA commitees .env con valores reales.
NODE_ENV=development

# Rol de la APLICACIÓN (sin BYPASSRLS, no dueño de tablas). RLS aplica.
DATABASE_URL=postgresql://reservas_app:CAMBIAR@localhost:5432/reservas_dev
DB_POOL_MAX=10

# Rol DUEÑO: solo para migraciones y seed (CLI de Prisma). La app nunca lo usa.
MIGRATION_DATABASE_URL=postgresql://reservas_owner:CAMBIAR@localhost:5432/reservas_dev
# Base "shadow" para `prisma migrate dev` (solo desarrollo).
SHADOW_DATABASE_URL=postgresql://reservas_owner:CAMBIAR@localhost:5432/reservas_shadow

# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Detrás de un proxy/CDN (OBLIGATORIO en producción): cabecera de IP que el proxy SOBRESCRIBE
# (p. ej. x-real-ip o cf-connecting-ip). Es la única fuente de IP para rate limiting.
AUTH_CLIENT_IP_HEADER=
# Alternativa: cantidad de proxies confiables para leer X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Tareas programadas (vencimientos, avisos, envío de emails, limpieza).
# - Servidor persistente (VPS, `next start`): EXPIRATION_SCHEDULER=internal.
# - Netlify / serverless: EXPIRATION_SCHEDULER=off. La función programada de Netlify
#   (netlify/functions/expire-pending.mts) llama a POST /api/internal/jobs/tick cada minuto.
#   UN SOLO scheduler: no actives ambos.
EXPIRATION_SCHEDULER=internal          # internal | off
EXPIRATION_INTERVAL_SECONDS=60
# Secreto para /api/internal/jobs/* y /api/health detallado (mín. 32 caracteres). Vacío = deshabilitado.
# Generar con: openssl rand -hex 32
CRON_SECRET=

# Emails (Fase 3). Proveedores: resend | log | memory | disabled
#  - Por defecto: development=log (imprime asunto/destinatario, NO envía), test=memory, production=disabled.
#  - Resend: crear cuenta, verificar dominio y recién ahí EMAIL_PROVIDER=resend.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM="TURNUP <no-reply@tu-dominio.com>"

# Alertas: webhook (Slack/Discord/etc.) que recibe fallas repetidas de jobs. Opcional.
ALERT_WEBHOOK_URL=

# Imágenes de canchas: database (por defecto, compatible con lo existente) | object (S3/R2)
IMAGE_STORAGE=database
S3_ENDPOINT=                           # p. ej. https://<cuenta>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Solo desarrollo: contraseñas del seed (si faltan, se generan y se muestran una vez).
SEED_SUPERADMIN_PASSWORD=
SEED_OWNER_PASSWORD=
